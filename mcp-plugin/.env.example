# Public deployment base URL. Use HTTPS in production.
PUBLIC_BASE_URL=https://mcp.example.com

# OAuth 2.1 authorization server settings.
# Configure these from your chosen OAuth provider; never commit real secrets.
OAUTH_ISSUER=https://auth.example.com/
OAUTH_AUDIENCE=ai-world-director-mcp
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Relay settings. Keep relay credentials separate from OAuth credentials.
RELAY_SHARED_SECRET=
RELAY_URL=wss://relay.example.com/connect

# Server
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
